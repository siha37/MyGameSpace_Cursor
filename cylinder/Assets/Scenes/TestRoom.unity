--- !u!114 &1561987108
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1561987106}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 1057665272}
    m_FontSize: 18
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "\u3010\uC774\uB3D9\u3011\nA / D : \uC9C8\uC8FC (\uB204\uB974\uB294 \uB3D9\uC548
    \uACF5\uC555 \uAC8C\uC774\uC9C0 \uCDA9\uC804)\nSpace : \uC810\uD504 (\uC9C8\uC8FC
    \uC911 \uC810\uD504\uD558\uBA74 \uB354 \uBA40\uB9AC \uB098\uAC10)\n\n\u3010\uC545\uC140
    \u2014 \uC720\uC77C\uD55C \uACF5\uACA9\u3011\nWASD \uB610\uB294 \uBC29\uD5A5\uD0A4\uB85C
    8\uBC29\uD5A5\uC744 \uB204\uB978 \uCC44 Shift\n\uAC8C\uC774\uC9C0 1\uCE78 \uC18C\uBAA8.
    \uACBD\uB85C\uC758 \uCCAB \uC801\uB9CC \uCC98\uD615\n\n\uC9C0\uC0C1\uC5D0\uC11C\uB294
    \uC544\uB798\uCABD \uC545\uC140 \uBD88\uAC00\n\uBCBD/\uCC9C\uC7A5\uC5D0 \uB2FF\uC73C\uBA74
    1\uCD08 \uBD80\uCC29 (\uC810\uD504 \uB610\uB294 \uC545\uC140\uB85C \uC774\uD0C8)\n\uCC9C\uC7A5\uC5D0\uC11C\uB294
    \uBC29\uD5A5\uD0A4 \uC5C6\uC774 Shift\uB9CC:\n  \uC6B0\uC0C1\uC73C\uB85C \uBD99\uC73C\uBA74
    \uC6B0\uD558 / \uC88C\uC0C1\uC73C\uB85C \uBD99\uC73C\uBA74 \uC88C\uD558\n  \uC218\uC9C1
    \uC0C1\uC2B9\uC73C\uB85C \uBD99\uC73C\uBA74 \uC9C1\uC804 \uC774\uB3D9\uBC29\uD5A5+\uD558\uB2E8\n\uCC9C\uC7A5\uC5D0\uC11C
    \uC88C\uC6B0 \uC218\uD3C9 \uC545\uC140 \uBD88\uAC00\n\uC545\uC140 \uC911 \uBC18\uB300
    \uBC29\uD5A5\uC73C\uB85C Shift : \uC5ED\uBD84\uC0AC (0.5\uCE78, \uC989\uC2DC
    \uC815\uC9C0)\n\uBCBD/\uCC9C\uC7A5\uC5D0 \uBABB \uB2FF\uC73C\uBA74 \uC18D\uB3C4
    20%\uB85C \uB099\uD558\n\n\u3010\uD5C8\uC218\uC544\uBE44\u3011\n\uB178\uB780
    \uD14C\uB450\uB9AC = \uC804\uBC29 (+X / -X, \uC989\uC2DC \uC804\uD658)\n\uBC29\uD5A5\uC744
    \uBC14\uAFC0 \uB54C \uB178\uB780 \uD45C\uAE30\uAC00 \uBC14\uB85C \uBC14\uB00C\uACE0
    0.8\uCD08 \uC815\uC9C0\uD55C \uB4A4 \uAC77\uB294\uB2E4\n\uC815\uBA74\uC73C\uB85C
    \uC545\uC140\uD558\uBA74 \uCDE8\uC18C + \uB109\uBC31 + 0.5\uCD08 \uC870\uC791
    \uBD88\uAC00\n\uB4A4\uB85C \uB4E4\uC5B4\uAC00 \uC545\uC140\uD558\uBA74 \uCC98\uD615
    (\uAC8C\uC774\uC9C0 +1)\n\n\u3010\uAC8C\uC774\uC9C0\u3011\n\uC2DC\uC791 4 / \uCD5C\uB300
    5\n\uC9C8\uC8FC \uC911 \uCDA9\uC804 \xB7 \uCC98\uCE58 +1 \xB7 \uC545\uC140 -1
    \xB7 \uC5ED\uBD84\uC0AC -0.5"
